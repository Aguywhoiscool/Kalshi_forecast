
# =====================================
# KALSHI API CONFIGURATION
# =====================================

# Environment: demo or production
KALSHI_ENV=demo

# Public REST API base URL
KALSHI_API_BASE_URL=

# Credentials (leave empty until needed)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=


# =====================================
# MARKET DATA COLLECTION
# =====================================

# Number of markets to monitor
MAX_MARKETS=10

# Minimum market activity threshold
MIN_VOLUME_24H=100

# Snapshot interval in milliseconds
SNAPSHOT_INTERVAL_MS=1000

# Directory for raw market data
RAW_DATA_DIR=data/raw

# Directory for processed datasets
PROCESSED_DATA_DIR=data/processed


# =====================================
# FORECASTING MODEL
# =====================================

# Input history: previous 60 observations
SEQUENCE_LENGTH=60

# Forecast horizons in seconds
PREDICTION_HORIZONS=1,5,10

# GRU layer sizes
GRU_UNITS_1=64
GRU_UNITS_2=32

# Training configuration
BATCH_SIZE=32
EPOCHS=50
LEARNING_RATE=0.001

# Validation settings
VALIDATION_SPLIT=0.15


# =====================================
# TRADING CONFIGURATION
# =====================================

# Never enable live trading initially
ENABLE_LIVE_TRADING=false

# Use simulated orders
ENABLE_PAPER_TRADING=true

# Maximum contracts per simulated order
MAX_POSITION_SIZE=10

# Minimum estimated edge before trading
MIN_EDGE=0.03


# =====================================
# LOGGING
# =====================================

LOG_LEVEL=INFO
LOG_DIR=logs
